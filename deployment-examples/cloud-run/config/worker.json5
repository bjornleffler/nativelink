// NativeLink worker for a Google Cloud Run worker pool.
//
// TWO ENDPOINTS, deliberately:
//   NL_CAS_ENDPOINT       - blob storage, on the CAS pool
//   NL_SCHEDULER_ENDPOINT - worker API, on the scheduler pool (port 50061)
// The CAS was split out of the scheduler so it no longer inherits the
// scheduler's single-instance constraint.
//
// Worker pools have no inbound HTTP endpoint and NativeLink workers open no
// listener of their own (`servers: []`) - the worker dials out to the
// scheduler and holds a long-lived gRPC stream. That is a clean fit.
//
// TWO CLOUD RUN CONSTRAINTS ARE ENCODED HERE:
//
// 1. `use_namespaces` / `use_mount_namespace` are false. Upstream calls them
//    "highly recommended" for hermeticity and zombie-process protection, but
//    nativelink-config/src/cas_server.rs notes they fail for non-privileged
//    containers, and Cloud Run never grants privileged. Watch long-lived
//    instances for leaked processes.
//
// 2. The container filesystem is tmpfs, so BOTH the fast store below and the
//    action work_directory consume instance memory. The fast-store budget
//    plus peak action memory must fit inside the instance memory limit, which
//    tops out at 32Gi.
{
  stores: [
    {
      name: "GRPC_CAS_STORE",
      grpc: {
        instance_name: "main",
        endpoints: [
          {
            address: "grpc://${NL_CAS_ENDPOINT}",
          },
        ],
        store_type: "cas",
      },
    },
    {
      name: "GRPC_AC_STORE",
      grpc: {
        instance_name: "main",
        endpoints: [
          {
            address: "grpc://${NL_CAS_ENDPOINT}",
          },
        ],
        store_type: "ac",
      },
    },
    {
      name: "WORKER_FAST_SLOW_STORE",
      fast_slow: {
        fast: {
          filesystem: {
            content_path: "/tmp/nativelink/content-worker",
            temp_path: "/tmp/nativelink/tmp-worker",
            eviction_policy: {
              // Counts against instance memory - see note 2 above.
              max_bytes: "${NL_WORKER_CACHE_BYTES:-2000000000}",
            },
          },
        },
        fast_direction: "get",
        slow: {
          // Indirection kept deliberately: repointing this at a GCS store
          // lets workers bypass the single CAS instance without touching the
          // scheduler, if the CAS becomes the throughput bottleneck.
          ref_store: {
            name: "GRPC_CAS_STORE",
          },
        },
      },
    },
  ],
  workers: [
    {
      local: {
        worker_api_endpoint: {
          uri: "grpc://${NL_SCHEDULER_ENDPOINT}",
        },
        cas_fast_slow_store: "WORKER_FAST_SLOW_STORE",
        upload_action_result: {
          ac_store: "GRPC_AC_STORE",
        },
        work_directory: "/tmp/nativelink/work",
        platform_properties: {
          // NOT `query_cmd: "nproc"`, which upstream's Kubernetes example uses.
          // Two reasons: the nativelink image ships no shell or coreutils, so
          // the command simply fails; and even where nproc exists it reports
          // the host's CPU count rather than the container's cgroup limit, so
          // on Cloud Run it would overreport and the scheduler would
          // over-assign work to this worker. Set this to match the --cpu value
          // the worker pool is deployed with.
          cpu_count: {
            values: ["${NL_WORKER_CPU_COUNT:-8}"],
          },
          memory_kb: {
            values: ["${NL_WORKER_MEMORY_KB:-4000000}"],
          },
          network_kbps: {
            values: ["100000"],
          },
          cpu_arch: {
            values: ["x86_64"],
          },
          OSFamily: {
            values: ["Linux"],
          },
          // WARNING: raw string matched by the scheduler against the value in
          // your Bazel platform's exec_properties. A mismatch here means
          // actions queue forever against workers that never claim them, with
          // no useful error anywhere. Verify this end to end.
          "container-image": {
            values: ["${NL_WORKER_PLATFORM:-undefined_platform}"],
          },
          "lre-rs": {
            values: ["${NL_WORKER_LRE_RS:-undefined}"],
          },
          ISA: {
            values: ["x86-64"],
          },
        },
        // See note 1 above. Both must stay false on Cloud Run.
        use_namespaces: false,
        use_mount_namespace: false,
      },
    },
  ],
  servers: [],
  global: {
    max_open_files: 524288,
  },
}
